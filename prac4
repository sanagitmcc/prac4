def a_star(graph, prev, dst, path, pcost, q):

    print("Connected nodes of current node", prev, "with h(n) value:")

    for n in graph[prev][0]:

        if n not in path and n not in q:

            q[n] = (graph[n][1], graph[prev][0][n])

            print(n, "->", q[n])

            add1 = sum(q[n])

            path_cost = pcost + add1

            print("A* value for", n, "=", path_cost)

    while q:

        mn = get_min(q)

        temp = q.pop(mn)

        print("Selecting Minimum vertex:", mn)
        print("----------------------------------------")

        if dst == mn:
            return path + [dst]

        pc = pcost + temp[1]

        new_path = a_star(
            graph,
            mn,
            dst,
            path + [mn],
            pc,
            q
        )

        if new_path:
            return new_path

    return []


